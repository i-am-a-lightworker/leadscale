# Supabase server settings. The service role key is server-only and bypasses RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
DATA_BACKEND=memory
INTAKE_MAX_BYTES=2000000

# Lead prioritization runtime. Mock mode needs no credentials.
AGENT_MODE=mock
NEXT_PUBLIC_USE_FIXTURES=true
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o-mini
AGENT_TIMEOUT_MS=15000
AGENT_CONCURRENCY=3
LEAD_MESSAGE_MAX_CHARS=4000

# Resend inbound domain/webhook.
RESEND_API_KEY=replace-me
RESEND_WEBHOOK_SECRET=replace-me
RESEND_INBOUND_DOMAIN=inbound.example.com

# Optional shared webhook protection for deployment-specific intake wiring.
INTAKE_WEBHOOK_SECRET=replace-me