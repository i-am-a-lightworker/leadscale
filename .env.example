# Supabase project settings. The service role key is server-only; never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Agent provider (used only after real agent wiring).
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini

# Resend inbound domain/webhook (inbound parsing is not implemented in this scaffold).
RESEND_API_KEY=replace-me
RESEND_WEBHOOK_SECRET=replace-me
RESEND_INBOUND_DOMAIN=inbound.example.com

# Optional shared webhook protection for deployment-specific intake wiring.
INTAKE_WEBHOOK_SECRET=replace-me